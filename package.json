{
  "name": "collabboard",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run client\" \"npm run server\"",
    "client": "cd ./client && npm run dev",
    "server": "cd ./server && npm run dev",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}